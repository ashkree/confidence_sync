# Copy this to .env and adjust as needed. .env should be gitignored.

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Used by the backend service (internal Docker DNS hostname "postgres")
DATABASE_URL=

# --- cognito-local ---
# Internal (container-to-container) endpoint, used by the backend to validate tokens.
COGNITO_ENDPOINT=
# These match the pool already seeded in .cognito/db/local_3Z6Efhtn.json
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# --- Frontend (browser-facing, must be host-reachable URLs) ---
VITE_USE_MOCK=
VITE_API_URL=
VITE_COGNITO_ENDPOINT=
